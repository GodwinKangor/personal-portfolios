# Copy this file to .env and fill in real values. .env is gitignored.

# Contact form: create a free form at https://formspree.io, then copy its ID
# (the part after /f/ in the endpoint URL it gives you) here.
REACT_APP_FORMSPREE_ID=

# Newsletter signup (Mailchimp embedded form action URL, split into parts)
REACT_APP_MAILCHIMP_URL=
REACT_APP_MAILCHIMP_U=
REACT_APP_MAILCHIMP_ID=
